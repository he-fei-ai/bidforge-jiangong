# ================================================================
# 专项方案工具箱 · .gitignore
# 生成时间：2026-09-26
# 原则：只跟踪源代码、配置模板、文档、测试；
#      排除缓存、临时产物、日志、真实数据库、密钥、用户数据。
# ================================================================

# ---------------- 密钥与凭证（安全红线） ----------------
# 真实密钥文件绝不入库；.env.example 才是可入库的配置模板
.env
.env.local
.env.*.local
*.key
!requirements.txt
secret_key.key
data/secret_key.key

# ---------------- Python ----------------
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
.eggs/
build/
dist/
.tox/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.pytype/
.coverage
.coverage.*
htmlcov/
.nose
.hypothesis/
.pytest_tmp*
# AI Agent 临时 pytest 目录（.pt_ 前缀）
.pt_*
# AI Agent 临时覆盖率目录
_no_cover*
_no_cov*
_diagnostics/
_exports/
*.bak-*
*.bak-preswap
*.orig_gbk
start_all.bat.orig_gbk

# ---------------- 后端运行时数据（真实数据/密钥，均不入库） ----------------
# 数据库、上传文件、导出目录、缓存
backend/app.db
backend/app.db.*
backend/scheme_assistant.db
backend/scheme_assistant.db.*
# 整个 data/ 目录：projects/ uploads/ _exports/ module_map.json（真实用户数据不入库）
backend/data/
# data/ 的手工快照备份（如 data_on_J_backup_20261103，仅本地留存）
backend/data_on_J_backup_*/
backend/cache/
backend/logs/
backend/_exports/
backend/_diagnostics/
backend/_pt_reg/
backend/.pytest_cgf/
backend/*.log
backend/*.txt
backend/*.ps1.log
backend/*.err
backend/*.out
# backend 根目录下的一次性调试脚本 / 临时文件
# ⚠️ 这些规则必须写在 backend/.gitignore：ruff 以 backend 为扫描根时，`backend/_*`
#    与 `/backend/_*` 都会被重写成无锚定的 `_*`，误伤 app/routers/_*.py、
#    **/__init__.py 等正式源码（2026-11-06 ruff 0.6.9 实测）。锚定到 backend 本目录
#    才能让 git 与 ruff 都只命中 backend 根目录的直接子项。
backend/check_db.py
# 依赖清单与配置模板必须入库（覆盖上面的 backend/*.txt 通配，规则顺序敏感）
!backend/requirements.txt
!backend/requirements-*.txt
!backend/.env.example
# pytest 自定义临时根目录（.t 前缀，生成测试夹具数据，不入库）
backend/.t*
# 测试分类工具的生成报告（随时可重建，不入库）
scripts/source_lock_report.csv
backend/tools/source_lock_report.csv
# backend/tests/ 下调试输出（保留 test_*.py / conftest.py / TEST_REPORT.md / .bak-*）
backend/tests/_*.txt
backend/tests/_*.log
backend/tests/_*.out
backend/tests/_*.err
backend/tests/.*_cache/
# 其他历史调试产物（字面量 $null 文件等）
backend/$null

# ---------------- 前端 ----------------
node_modules/
frontend/dist/
frontend/tsconfig.tsbuildinfo
frontend/out.log
frontend/*.log
frontend/*.txt
frontend/*.out
frontend/*.err
frontend/_*
frontend/_audit*
frontend/_chk*
frontend/_dump*
frontend/_facts_modal_dump*
frontend/_fe_after_*
frontend/_fi_*
frontend/_inline*
frontend/_probe*
frontend/_qoder_*
frontend/_reg_*
frontend/_rg*
frontend/_round*
frontend/_swap*
frontend/_s_*
frontend/_tsc*
frontend/_vitest*
# vitest 基准输出
frontend/.vitest_bf.json
frontend/_swap_*
vitest_result.json

# ---------------- 图表子项目 ----------------
chart-gap-filler/.pytest_cache/
chart-gap-filler/.ruff_cache/
chart-gap-filler/__pycache__/
chart-gap-filler/_demo/
chart-gap-filler/*.log

# ---------------- 根目录临时产物 ----------------
_openapi.json
_probe_conn.py
_tmp_*.ps1
_tmp_*.py
_tmp_*.txt
_find_copy.log
# AI Agent 批量回归的 stdout/stderr 重定向（2026-10-07 加固，如 _ab_aibase.*）
_ab_*
# 各专项过程产物（基线日志/报告/源码备份，仅本地留存，不入库；2026-10-07）
artifacts/
patch_preview_pipeline_summary.py
patch_preview_pipeline_summary.py.bak*
kill_port_selftest.ps1.log
*.lock
# AI Agent 批量回归临时产物（_rNN_*.log/.err）
_r[0-9]*_*.log
_r[0-9]*_*.err
# pytest 自定义 cache_dir 产物
.pytest_cache_verify/
backend/.pytest_cache_verify/
~$*
~$xport*

# ---------------- 日志 ----------------
logs/
*.log
*.log.*

# ---------------- IDE / AI 工具 / 编辑器缓存 ----------------
.arts/
.codeartsdoer/
.codebuddy/
.trae/
.zcode/
.vscode/
.workbuddy-ai/
.idea/
*.swp
*.swo
*~

# ---------------- 系统 & 备份 ----------------
.DS_Store
Thumbs.db
desktop.ini
*.bak
*.tmp
*.temp

# ---------------- 导出/截图产物 ----------------
*.docx
!docs/**/*.docx
_tmp_screenshot.png
*.png
!docs/**/*.png
!examples/**/*.png
!backend/app/**/*.png

# ---------------- 归档目录 ----------------
# backend/legacy_scripts/ 的忽略规则已迁至 backend/.gitignore（原因同上：跨根解析歧义）。
