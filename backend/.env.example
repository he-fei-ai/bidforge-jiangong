# ================================================================
# 专项方案工具箱 · 后端配置模板
# 用法：复制为 backend/.env 后按需修改；真实 .env 不入库。
# 完整配置项（180 项，含默认值）见 backend/app/config.py。
# ================================================================

# ---------------- 基础 ----------------
# ⚠️ 必须显式评估：默认值是相对路径 sqlite+aiosqlite:///<backend>/data/scheme_assistant.db，
#    该路径随进程 CWD 漂移（从不同目录启动会生成多个不同的库文件）。
#    部署时建议写绝对路径，如 sqlite+aiosqlite:///J:/data/scheme_assistant.db
# DATABASE_URL=
# ⚠️ 局域网/公网部署必须显式设置（后端默认绑定 0.0.0.0，token 为空 = 任何同网段
#    主机可直接调用全部 API）。为空仅限本机自用场景。
API_AUTH_TOKEN=
# 跨域来源白名单，逗号分隔。示例为本地开发默认前端端口；
# `*` 表示放行任意来源（配合空 token 等于把 API 完全敞开给任意网页，
# 存在 CSRF/数据外泄风险），仅限本机调试临时使用，部署时禁止。
CORS_ORIGINS=http://localhost:5175
# 反向代理的信任来源，逗号分隔
TRUSTED_PROXY_IPS=
# 管理面接口（/admin/*，当前为 /admin/prompts/*）专用凭据。
# ✅ R179（2026-11-05）：默认空 = fail-closed —— 只允许**本机回环来源**
#    （127.0.0.1 / ::1）访问管理接口，非回环一律 403；本地单机使用零变化，
#    向后兼容（老 .env 不写本项时行为如上，不会放开远程管理）。
# ⚠️ 非空 = 必须携带 `X-Admin-Token: <token>` 或 `Authorization: Bearer <token>`，
#    放行后不再限制来源。与 API_AUTH_TOKEN 独立，二选一/可同时设置：
#      · 仅 API_AUTH_TOKEN：全局 API 需凭据，但远程仍无法访问管理接口；
#      · 需远程管理 → 必须同时设置 ADMIN_API_TOKEN，并让前端注入 X-Admin-Token
#        （构建期 VITE_ADMIN_TOKEN 或 localStorage.admin_token）。
ADMIN_API_TOKEN=
# 可选：32 字节 urlsafe base64 的 Fernet key；为空时自动生成到 data/ 下
# ⚠️ 自动生成的 key 落盘在 data/ 目录，删除该目录或换机器部署会导致
#    已加密数据无法解密；生产环境必须显式设置并妥善备份。
FERNET_KEY=

# ---------------- 上传与解析 ----------------
UPLOAD_MAX_BYTES=31457280
UPLOAD_MAX_FILES_PER_REQUEST=20
UPLOAD_MAX_TOTAL_BYTES=209715200
OCR_ENABLED=true
OCR_ENGINE=auto
OCR_LANG=chi_sim+eng
TESSERACT_PATH=
TESSERACT_DATA_PATH=
MINERU_ENABLED=true
MINERU_PROVIDER=
MINERU_TOKEN=
LEGACY_OFFICE_ENABLED=true
LEGACY_OFFICE_PATH=

# ---------------- AI 主模型 ----------------
AGNES_API_KEY=
AGNES_BASE_URL=https://api.agnes-ai.cn/v1
AGNES_MODEL=agnes-2.5-flash
AI_REQUEST_TIMEOUT=900
AI_FALLBACK_CHAIN_MAX=3
MAX_CONCURRENCY=5
DEFAULT_CONCURRENCY=3
# ✅ R175（2026-11-03）：AI Base URL 内网地址访问开关。
#    默认 false = 拒绝指向回环(127/8、::1)、私网(10/8、172.16/12、192.168/16)、
#    链路本地(169.254/16，含云元数据 169.254.169.254)、0.0.0.0、localhost 及
#    解析后落到上述网段的域名（防 SSRF）。
#    ⚠️ 仅在本机自建模型服务（Ollama/vLLM/LM Studio）确实需要被后端直连时设为 true；
#       打开后后端可被指示向任意内网地址发请求，并可能把已保存的 API Key 外发到该地址。
#       仅限可信的单机/内网部署，生产环境保持 false。
AI_ALLOW_PRIVATE_BASE_URL=false

# ---------------- U5 分组预热编排（2026-11-05，默认关） ----------------
# 默认 false = 与引入前逐字等价：不读其余 AI_WARMUP_*、不加等待、不改调度。
# 打开后每个分组先跑固定第一个「代表」，成功后再等 AI_WARMUP_DELAY_MS 让上游
# 缓存共享前缀，其余项按 AI_WARMUP_STAGE_CONCURRENCY 并发。
# ⚠️ 本组配置不改变既有并发默认值（BID_ANALYSIS_ITEM_CONCURRENCY 仍为 1、
#    MAX_CONCURRENCY 仍为 5），放大量只由阶段上限自带的默认 2 控制。
AI_WARMUP_ENABLED=false
# 代表成功后等待（毫秒）；默认 5000，与既有 bid_analysis 预热常量等值。
AI_WARMUP_DELAY_MS=5000
# 分阶段并发上限（默认 2）。设为 1 时等于未开启（启动日志 WARNING 提示）。
AI_WARMUP_STAGE_CONCURRENCY=2
# 分阶段并发表（JSON，如 {"content":2,"facts":2}）；空 = 用上面的默认值。
AI_WARMUP_STAGE_CONCURRENCY_MAP=
# 启用阶段（逗号分隔）：outline,content,facts,consistency_scan
AI_WARMUP_STAGES=outline,content,facts,consistency_scan
# 代表失败后整组退化串行（默认 true）
AI_WARMUP_FALLBACK_SERIAL=true
# 仅「解析失败」允许换下一个代表重试一次（默认 true）
AI_WARMUP_REP_RETRY_ON_PARSE=true
# 分阶段等待表（JSON，毫秒，如 {"content":5000,"facts":2000}）；空 = 用 AI_WARMUP_DELAY_MS
AI_WARMUP_STAGE_DELAY_MS=

# ---------------- M1 评分项 → 目录覆盖校验（2026-11-05，只读配置） ----------------
# 抽取只扫「评标办法 / 评分标准」候选页块；以下为上限与四级匹配阈值。
# 全部为纯追加项，不改变任何既有行为；覆盖率报告不缓存。
SCORING_EXTRACT_MAX_DOCS=4
SCORING_EXTRACT_MAX_CHARS=60000
SCORING_EXTRACT_TIMEOUT=120
SCORING_THRESHOLD_EXACT=0.95
SCORING_THRESHOLD_CONTAINS=0.85
SCORING_THRESHOLD_KEYWORD_HIGH=0.65
SCORING_THRESHOLD_KEYWORD_MID=0.55
SCORING_THRESHOLD_KEYWORD_LOW=0.45
# extra（多余章节）判定的结构白名单（逗号分隔，不进 missing/extra 计算）
SCORING_EXTRA_WHITELIST=附图,附表,附件,封面,目录,编制说明

# ---------------- N1 目录生成自动确认（2026-11-05，开关默认关） ----------------
# 开关本身存 SQLite governance_settings kv（默认 false = 完全现状：只弹人工确认闸门），
# 不在这里配置；下面只配置倒计时时长。
# 面向运维，不建议用户改（终端界面不暴露此项；改小会缩短自动确认等待，
# 改大可能让用户以为卡住）。
OUTLINE_AUTO_CONFIRM_DELAY_MS=8000

# ---------------- AI 生图（可选） ----------------
IMAGE_ENABLED=true
# 供应商选择：agnes | dashscope | volcengine | hunyuan | zhipu | stepfun | baidu
# （pydantic settings 字段 image_provider，默认 agnes，见 config.py）
IMAGE_PROVIDER=
# 出图分辨率：1K/2K/3K/4K（字段 image_default_size，默认 2K）
IMAGE_DEFAULT_SIZE=
IMAGE_MODEL=
IMAGE_BASE_URL=
IMAGE_API_KEY=
IMAGE_MAX_CONCURRENCY=2
# ✅ R179（N-09）：配置连通性批量预检（/ai/config/precheck-all）的最大并发探测数。
# 每条探测一个线程（DNS+TCP，各 5s 超时）；默认 8，配置数 ≤8 时行为与旧版一致。
# 非正数/非法值回落 8。仅在配置条目远超 8 条时需要调大/调小。
PRECHECK_MAX_CONCURRENCY=8
# 人工生图入口默认关闭；开启后 /charts/generate-ai-image 才可用
AI_IMAGE_MANUAL_ENABLED=false
# ---- 生图供应商直连密钥（按所选供应商二选一/多选一配置）----
# 百度：访问令牌（app/services/ai/image_providers/baidu.py 直读）
BAIDU_ACCESS_TOKEN=
# 阿里通义万相：API Key（dashscope.py 直读）
DASHSCOPE_API_KEY=
# 火山引擎即梦：AK/SK 对（volcano.py 直读）
VOLC_ACCESS_KEY=
VOLC_SECRET_KEY=

# ---------------- 目录生成 ----------------
# 目录生成模式：auto | oneshot | stepwise（唯一判定点见
# sse_handlers._use_stepwise_for_budget，默认 auto）
#   auto     = 按方案字数预算与分步阈值（OUTLINE_STEPWISE_MIN_WORDS，出厂 50000）
#              比较：超过走分步，否则一次性直出。**与旧版本行为逐字一致**，
#              老 .env 不写本项时即 auto，无需迁移。
#   oneshot  = 强制一次性直出（若失败且 OUTLINE_ONESHOT_FALLBACK_STEPWISE=true，
#              仍会自动降级分步，二者不冲突）
#   stepwise = 强制分步生成（一级目录 → 逐章二三级 → 审核）
OUTLINE_SCHEME=auto

# ---------------- 内容生成与流式 ----------------
CONTENT_REQUEST_TIMEOUT=300
CONTENT_TOTAL_TIMEOUT=660
SSE_TOTAL_TIMEOUT_DEFAULT=1800
# section_done 事件体积上限（字符数，按 UTF-8 中文不转义的 JSON 长度估算）。
# 0/负数 = 不截断（默认，与引入前完全一致）。实测单章事件约 2~40KB；如需
# 防护可设为 262144（256KB），超出时只截断 content，并附 truncated /
# truncated_chars / kept_chars / content_ref / truncation_note，前端可据此
# 提示并重新拉取全文（正文已落库，断线重挂与检查点续跑不受影响）。
SECTION_DONE_PAYLOAD_MAX_CHARS=0

# ---------------- Mermaid 云端渲染（可选，缺省走本地 PIL 兜底） ----------------
# Docker 化 Mermaid HTTP 服务地址（mermaid_service.py 探测用）
MERMAID_SERVICE_URL=
# Railway 托管 Mermaid 服务地址；与上一项都为空 = 未部署，纯本地渲染
MERMAID_RAILWAY_URL=

# ---------------- 图表渲染缓存 ----------------
# 覆盖默认缓存目录 <backend>/data/_exports/charts（config.py:18）；
# 主要供测试/独立进程隔离使用，避免与常驻后端争用 PNG 缓存文件
#（Windows 下表现为 [Errno 13] Permission denied）。默认留空即生产行为不变。
BIDFORGE_CHART_CACHE_DIR=

# ---------------- 图表字体 ----------------
# 覆盖内置字体搜索路径（mermaid_common.py），分号分隔多个路径；
# 留空使用内置的 Windows 常见中文字体列表（微软雅黑/黑体/宋体等）
FONT_PATH=

# ---------------- 前端配套（Vite 构建期注入） ----------------
# ⚠️ VITE_ 前缀变量由 Vite 在【前端构建期】读取，仅写在 backend/.env 无效；
#    请配置到 frontend/.env（参见 frontend/.env.example）。
#    取值与后端 API_AUTH_TOKEN 保持一致，用于前端直连鉴权。
# VITE_API_TOKEN=

# ---------------- 提示词治理 ----------------
# 默认关闭；开启后对注入资料做注入检测
PROMPT_INJECTION_DEFENSE=false
# 0 表示按模板内置预算
PROMPT_CONTEXT_BUDGET=0
PROMPT_STRICT_VARIABLES=false

# ✅ R175（2026-11-03）：外部资料凭据脱敏。默认 false（与修复前行为逐字节一致）。
# ⚠️ 风险：默认关闭时，用户上传的招标/项目资料原文会**原样发送**给外部 AI
#    服务商；若资料中含系统账号、数据库口令、API Key，会随请求外发。
#    生产环境强烈建议设为 true（只做出站替换，不改库内原文，可随时改回 false）。
#    ⚠️ 注意：本开关与 PROMPT_INJECTION_DEFENSE 互不影响，可单独开启。
PROMPT_REDACT_SENSITIVE=false
# 说明：以上 4 个开关都支持运行时修改（PUT /system/governance），
#      修改后**落库**，重启仍生效（旧版本只写内存、重启即失效，已修）。

# ---------------- 审核与预检 ----------------
# 单次 /check 或 /consistency-audit 的分批送审成本上限（D-41）。
# 每批 = 一次 AI 调用（单批约 6000 字），默认 40 批 / 240000 字，与引入时行为一致。
# ⚠️ 调大意味着单次审核更贵：调用次数与 token 消耗随上限线性增长。
# 取值 <=0 表示该维度无上限（首次读取记 WARNING），生产环境不建议关闭。
COMPLIANCE_MAX_BATCHES=40
COMPLIANCE_MAX_CHARS=240000

# ---------------- 导出 ----------------
EXPORT_DEDUP_CONCURRENT=true
EXPORT_CACHE_FAST_PATH=true

# ---------------- 本地代理（可选） ----------------
PROXY_HOST=
PROXY_PORT=

# ---------------- 底层 Agent 引擎双轨演进（R240 · 路径 B 注入执行器 POC） ----------------
# 架构决策：双轨落地 / 引擎路由 / 默认回退 / 灰度上线。业务层 Prompt 与流程逻辑
# **保持现状不动**；本组配置每次任务动态读取（改环境变量后立即生效，无需重启）。
# 运维面：GET /api/v1/omp/diagnostics 的 dual_track 字段可只读查看当前生效配置。
#
# 【可开关】引擎模式：pi（旧轨，默认，等价改造前行为）/ omp（oh-my-pi 新轨）/
#          hybrid（双轨灰度）。⚠️ 默认必须是 pi —— 任何新配置上线都不改变既有链路。
AGENT_ENGINE_MODE=pi
# 全局 Feature Flag：false = 强制全量走 pi（一键回退，不进降级链）。
AGENT_ENGINE_ENABLED=true
# 默认回退开关：omp 失败（未安装 / 未授权 / 崩溃 / 超时 / 异常结构）自动降级 Pi 轨，
# 打 WARN 日志并在 AgentResult.meta.degraded 标注，绝不静默改道。
AGENT_ENGINE_FALLBACK_ENABLED=true
#
# 【配置化 · 严禁硬编码】以下阈值/路径/凭据/重试一律从配置中心读取。
# omp 二进制绝对路径；留空 = 复用既有 OMP_BINARY_PATH（单一事实源，不复制第二份值）。
AGENT_ENGINE_OMP_BINARY_PATH=
# 上下文压缩阈值比率（0,1]：上下文体积 > 窗口 × 比率 时走文件工作区（引擎层判定）。
AGENT_ENGINE_CONTEXT_THRESHOLD_RATIO=0.7
# 单帧文本超过该字数先压缩（首尾保留 + 摘要 + 全文写工作区供 read 分段读取）。
AGENT_ENGINE_COMPACTION_THRESHOLD=120000
# omp 执行失败的最大重试次数（不含首次）；0 = 不重试直接回退；上限钳制 10。
AGENT_ENGINE_MAX_RETRIES=2
# 指数退避基数（秒）：第 n 次重试前等待 base × 2**n。
AGENT_ENGINE_RETRY_BACKOFF_BASE=1.5
# 单任务外层硬超时（秒）；留空 = 复用既有 OMP_TASK_TIMEOUT。
AGENT_ENGINE_TASK_TIMEOUT=
# Provider 授权凭据文件（JSON：环境变量名 → 值）；留空 = 不注入，沿用 omp models.yml。
# ⚠️ 仅注入 omp 子进程，绝不写日志；诊断端点只回报「是否配置」，不回传路径/内容。
AGENT_ENGINE_PROVIDER_AUTH=
#
# 【可灰度】hybrid 模式按稳定哈希（blake2b）分桶，同一 ID 恒定落同一轨、放量不抖动。
# 命中 omp 的百分比 [0,100]：0 = 全量 pi，100 = 全量 omp。
AGENT_ENGINE_GRAY_PERCENT=0
# 灰度哈希键：scheme_id（项目/方案级）/ task_id（任务级）。
AGENT_ENGINE_GRAY_KEY=scheme_id
#
# 【路径 B · 注入执行器 POC】real = 拉起真 omp 进程；mock = 注入 MockOmpExecutor
# （读取预置 JSON 响应 / 模拟流式帧，不启动子进程、不消耗模型额度）。
# ⚠️ 生产恒为 real；仅在离线 POC / 集成测试环境设为 mock。
AGENT_ENGINE_OMP_EXECUTOR_IMPL=real
# Mock 预置响应文件（JSON）；留空 = 使用内置样例响应（仅离线 POC 用）。
AGENT_ENGINE_MOCK_RESPONSE_PATH=
