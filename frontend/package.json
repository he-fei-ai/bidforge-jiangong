{
  "name": "scheme-assistant-frontend",
  "version": "5.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --port 5175 --host",
    "build": "tsc && vite build",
    "preview": "vite preview --port 5175",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:facts": "vitest run factsTab factsApi",
    "test:content": "vitest run contentTab contentEvents contentStandard SectionContentCard",
    "test:outline": "vitest run outline OutlineLibrary",
    "test:ai-config": "vitest run aiConfig",
    "test:import-upload": "vitest run importSubTabBar upload documentParseList DocumentPipelineSummary parseResultCategoryPanel parseSourceNotice",
    "test:review": "vitest run ReviewWorkflowPanel ReadinessDashboard reviewApiContract auditTypesContract",
    "test:workflow": "vitest run schemeWorkbench baItemFlatList bidAnalysis workflowDerived workflowTabsGuard"
  },
  "dependencies": {
    "@ant-design/icons": "^5.6.0",
    "@types/katex": "^0.16.8",
    "antd": "^5.29.3",
    "axios": "^1.12.0",
    "dompurify": "^3.4.15",
    "katex": "^0.18.7",
    "marked": "^14.0.0",
    "mermaid": "^11.0.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-router-dom": "^7.18.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "jsdom": "^30.0.1",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.71.0",
    "vite": "^6.0.0",
    "vitest": "^3.2.4"
  }
}
