# 根 EditorConfig —— 统一缩进/字符集等基础约定
# 注意：本仓不设 end_of_line。理由：
#   1. git core.autocrlf=true，行尾归一由 git 在提交时完成（索引内 CRLF/LF 混杂）；
#   2. 存在 R57/r65 等字节级体检护栏，强制编辑器改写行尾会造成与 HEAD 基线
#      不等价的假差异。新增/编辑文件时保持所在平台的现有行尾即可。
root = true

# ---------- Python（后端，4 空格，行长上限与 ruff line-length 对齐） ----------
[*.py]
indent_style = space
indent_size = 4
max_line_length = 120
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true

# ---------- 前端（TS/TSX/JS/JSON/CSS，2 空格，与现有隐性约定一致） ----------
[*.{ts,tsx,js,cjs,mjs,json,css,html}]
indent_style = space
indent_size = 2
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true

# ---------- CI / 配置 ----------
[*.{yml,yaml,toml,ini}]
indent_style = space
indent_size = 2
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true

# ---------- Markdown：行尾空格在 MD 中有语义（硬换行），不做裁剪 ----------
[*.md]
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = false

# ---------- PowerShell 脚本（4 空格） ----------
[*.ps1]
indent_style = space
indent_size = 4
insert_final_newline = true

# ---------- 批处理：编码与 CJK 输出强相关（历史存在 GBK 版本），不强制 charset ----------
[*.{bat,cmd}]
indent_style = space
indent_size = 4
